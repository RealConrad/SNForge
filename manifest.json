{
  "manifest_version": 3,
  "name": "SNForge",
  "version": "0.1.0",
  "description": "ServiceNow developer utilities.",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "dist/background/background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.service-now.com/*"],
      "js": ["dist/content/palette.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
