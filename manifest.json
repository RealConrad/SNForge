{
  "manifest_version": 3,
  "name": "SNForge",
  "version": "0.1.0",
  "description": "Keyboard command palette for ServiceNow admins.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SNForge",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space"
      },
      "description": "Open or close the SNForge command palette"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'"
  }
}
